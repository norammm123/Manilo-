/* app.wxss - Manilo掌音 全局样式 */
page {
  --primary: #2B7FFF;
  --primary-light: #E8F4FF;
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;
  --text-main: #1F1F1F;
  --text-secondary: #666666;
  --text-muted: #999999;
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --border: #E8E8E8;
  --shadow: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-lg: 0 4px 16px rgba(0,0,0,0.1);
  --radius-sm: 8rpx;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  
  background: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
}

/* 导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 100rpx 32rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-logo {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 卡片基础 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: var(--shadow);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-online {
  background: #E6F7E6;
  color: var(--success);
}

.status-offline {
  background: #FFE6E6;
  color: var(--danger);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx 48rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
  border: none;
}

.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(43,127,255,0.3);
}

.btn-primary:active {
  background: #1a6fee;
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);
}

.btn-large {
  width: 100%;
  height: 96rpx;
}

/* 数据展示 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 32rpx 16rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.stat-trend {
  font-size: 20rpx;
  color: var(--success);
  margin-top: 4rpx;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius);
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 36rpx;
}

.list-content {
  flex: 1;
}

.list-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.list-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 功能网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}

.feature-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  text-align: center;
  box-shadow: var(--shadow);
  transition: all 0.2s;
}

.feature-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-lg);
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 圆形进度 */
.progress-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: conic-gradient(var(--primary) 0deg, var(--border) 0deg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.progress-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.progress-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 底部操作区 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: none; }
}

.animate-in {
  animation: fadeIn 0.4s ease-out;
}

/* 滚动区域 */
.scroll-container {
  height: calc(100vh - 200rpx);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: #E6F7E6;
  color: var(--success);
}
