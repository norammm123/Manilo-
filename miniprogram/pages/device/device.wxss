/* pages/device/device.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.nav-bar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 120rpx 40rpx 40rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.device-card {
  text-align: center;
  padding: 60rpx 40rpx;
}

.device-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.device-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.device-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 24rpx 0 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.online {
  background: var(--success);
}

.status-dot.offline {
  background: var(--danger);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.setting-info {
  flex: 1;
}

.setting-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.setting-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.setting-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.vibrate-options {
  margin-top: 24rpx;
}

.vibrate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.vibrate-item:last-child {
  border-bottom: none;
}

.vibrate-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.info-list {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}
