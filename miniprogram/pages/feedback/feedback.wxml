<!-- pages/feedback/feedback.wxml - 反馈建议 -->
<view class="page">
  <view class="content">
    <view class="card">
      <view class="card-title">告诉我们你的想法</view>
      <textarea class="input" placeholder="遇到的问题、建议的功能、想说的话..." 
                maxlength="500" bindinput="onInput" value="{{content}}"></textarea>
      <view class="count">{{content.length}}/500</view>
      <button class="submit-btn" bindtap="submit" disabled="{{sending}}">
        {{sending ? '提交中...' : '提交反馈'}}
      </button>
    </view>

    <view class="tip">反馈会同步到后端，帮助团队改进产品</view>
  </view>
</view>
