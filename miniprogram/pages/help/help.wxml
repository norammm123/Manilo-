<!-- pages/help/help.wxml - 使用帮助 -->
<view class="page">
  <view class="content">
    <view class="card" wx:for="{{sections}}" wx:key="title">
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.desc}}</view>
      <view class="steps">
        <view class="step" wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this">
          <text class="step-num">{{index + 1}}</text>
          <text class="step-text">{{step}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
