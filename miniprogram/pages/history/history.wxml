<!-- pages/history/history.wxml - 历史记录 -->
<view class="page">
  <view class="content">
    <view class="card" wx:if="{{stats}}">
      <view class="card-header">
        <text class="card-title">今日识别</text>
      </view>
      <view class="stat-grid">
        <view class="stat-box">
          <text class="stat-num">{{stats.sentences_today || 0}}</text>
          <text class="stat-label">成句</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{stats.predictions_today || 0}}</text>
          <text class="stat-label">识别次数</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{stats.confStr}}</text>
          <text class="stat-label">置信度%</text>
        </view>
      </view>
    </view>

    <view class="section-title">识别记录</view>

    <view class="error-box" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>

    <view class="history-list" wx:if="{{records.length > 0}}">
      <view class="history-item" wx:for="{{records}}" wx:key="index">
        <view class="history-icon">✋</view>
        <view class="history-content">
          <text class="history-text">{{item.text}}</text>
          <text class="history-time">{{item.date_text}} {{item.time}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !error && records.length === 0}}">
      <text>暂无识别记录，戴上手套试试吧</text>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
