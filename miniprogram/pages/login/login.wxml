<!-- pages/login/login.wxml - 登录页 -->
<view class="page">
  <!-- 品牌区 -->
  <view class="hero">
    <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
    <text class="app-name">Manilo掌音</text>
    <text class="app-slogan">用科技连接声音，让沟通更简单</text>
  </view>

  <!-- 登录区 -->
  <view class="login-area">
    <button class="login-btn" bindtap="wechatLogin" loading="{{wxLogging}}">
      <text class="wx-icon">微</text>
      <text>{{wxLogging ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view class="divider">
      <view class="line"></view>
      <text class="divider-text">或</text>
      <view class="line"></view>
    </view>

    <button class="guest-btn" bindtap="guestLogin">暂不登录，游客体验</button>
  </view>

  <view class="footer">
    <text>登录即代表同意《用户协议》和《隐私政策》</text>
  </view>
</view>
