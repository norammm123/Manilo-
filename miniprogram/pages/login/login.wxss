/* pages/login/login.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 160rpx 60rpx 80rpx;
  box-sizing: border-box;
}

/* 品牌区 */
.hero { text-align: center; }

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  margin-bottom: 48rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  display: block;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 20rpx;
  display: block;
}

/* 登录区 */
.login-area { width: 100%; }

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #333;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  line-height: 96rpx;
  padding: 0;
}

.login-btn[disabled] { background: rgba(255,255,255,0.8); color: #999; }

.wx-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: #07C160;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0;
}

.line { flex: 1; height: 1rpx; background: rgba(255,255,255,0.3); }
.divider-text { font-size: 24rpx; color: rgba(255,255,255,0.7); }

.guest-btn {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  padding: 0;
}

.guest-btn[disabled] { opacity: 0.6; }

/* 底部 */
.footer { text-align: center; }
.footer text { font-size: 22rpx; color: rgba(255,255,255,0.6); }
