<!-- pages/profile-edit/profile-edit.wxml - 完善资料 -->
<view class="page">
  <view class="nav-bar">
    <text class="nav-title">完善资料</text>
  </view>

  <view class="content">
    <!-- 头像 -->
    <view class="avatar-wrap">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" class="avatar-img"></image>
        <view wx:else class="avatar-placeholder">
          <text>＋</text>
          <text class="avatar-tip">点击选择头像</text>
        </view>
      </button>
    </view>

    <!-- 昵称 -->
    <view class="field">
      <text class="field-label">昵称</text>
      <input class="field-input" type="nickname" placeholder="请输入昵称"
             placeholder-class="ph" value="{{nickname}}" bindinput="onNickname" />
    </view>

    <button class="save-btn" bindtap="save" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存并进入'}}
    </button>

    <view class="skip" bindtap="skip">跳过，稍后再说</view>
  </view>
</view>
