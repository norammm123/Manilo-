<!-- pages/report/report.wxml - 训练报告 -->
<view class="page">
  <view class="content">
    <!-- 今日统计 -->
    <view class="card" wx:if="{{stats}}">
      <view class="card-header">
        <text class="card-title">今日统计</text>
      </view>
      <view class="stat-grid">
        <view class="stat-box">
          <text class="stat-num">{{stats.sessions_today || 0}}</text>
          <text class="stat-label">练习次数</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{stats.predictions_today || 0}}</text>
          <text class="stat-label">识别次数</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{stats.sentences_today || 0}}</text>
          <text class="stat-label">成句数</text>
        </view>
      </view>
    </view>

    <!-- 历史报告列表 -->
    <view class="section-title">历史报告</view>

    <!-- 错误提示 -->
    <view class="error-box" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>

    <view class="report-list" wx:if="{{reports.length > 0}}">
      <view class="report-item" wx:for="{{reports}}" wx:key="session_id" bindtap="viewReport" data-id="{{item.session_id}}">
        <view class="report-head">
          <text class="report-mode">{{item.mode === 'gesture' ? '手势练习' : '拼音练习'}}</text>
          <text class="report-date">{{item.created_at_text}}</text>
        </view>
        <text class="report-summary">{{item.summary || '暂无摘要'}}</text>
        <view class="report-foot">
          <text class="report-meta">{{item.metrics_text}}</text>
          <text class="report-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !error && reports.length === 0}}">
      <text>还没有训练报告，先去练一组吧</text>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
