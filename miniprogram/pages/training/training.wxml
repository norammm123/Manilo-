<!-- pages/training/training.wxml - 训练页面 -->
<view class="page">
  <view class="nav-bar">
    <text class="nav-title">康复训练</text>
    <text class="nav-subtitle">手语学习与发音训练</text>
  </view>

  <scroll-view class="scroll-container" scroll-y>
    <!-- 训练模式选择 -->
    <view class="section-title">选择训练模式</view>
    <view class="mode-list">
      <view class="mode-card {{currentMode === 'echo' ? 'active' : ''}}" bindtap="switchMode" data-mode="echo">
        <view class="mode-icon">🔊</view>
        <view class="mode-title">回声映射</view>
        <view class="mode-desc">声音→手语→图像</view>
      </view>
      
      <view class="mode-card {{currentMode === 'speak' ? 'active' : ''}}" bindtap="switchMode" data-mode="speak">
        <view class="mode-icon">🎤</view>
        <view class="mode-title">主动发声</view>
        <view class="mode-desc">手语→发音→纠错</view>
      </view>
      
      <view class="mode-card {{currentMode === 'chat' ? 'active' : ''}}" bindtap="switchMode" data-mode="chat">
        <view class="mode-icon">💬</view>
        <view class="mode-title">情景对话</view>
        <view class="mode-desc">双向实时交流</view>
      </view>
    </view>

    <!-- 当前训练内容 -->
    <view class="card training-card">
      <view class="training-header">
        <text class="training-title">{{modeTitle}}</text>
        <view class="tag tag-primary">{{modeSubtitle}}</view>
      </view>

      <!-- 回声映射模式 -->
      <view class="training-content" wx:if="{{currentMode === 'echo'}}">
        <view class="echo-display">
          <view class="echo-icon">{{currentWord.emoji || '🔊'}}</view>
          <text class="echo-word">{{currentWord.text || '等待声音输入...'}}</text>
          <text class="echo-pinyin">{{currentWord.pinyin || ''}}</text>
        </view>
        <button class="btn btn-secondary" bindtap="playSound">🔊 播放标准发音</button>
      </view>

      <!-- 主动发声模式 -->
      <view class="training-content" wx:if="{{currentMode === 'speak'}}">
        <view class="speak-ring" wx:if="{{!isRecording}}">
          <view class="ring-inner">
            <text class="ring-score">{{score || '--'}}</text>
            <text class="ring-label">准确度</text>
          </view>
        </view>
        <view class="recording-box" wx:if="{{isRecording}}">
          <view class="recording-pulse"></view>
          <text class="recording-text">录音中，请跟读「{{targetWord}}」，说完再点一次停止</text>
        </view>
        <view class="speak-word">{{targetWord || '点击开始跟读'}}</view>
        <view class="heard-text" wx:if="{{recordingText}}">
          <text>{{recordingText}}</text>
        </view>
        <view class="btn-row">
          <button class="btn btn-secondary" bindtap="playSound">🔊 听示范</button>
          <button class="btn {{isRecording ? 'btn-danger' : 'btn-primary'}}" bindtap="startRecord">
            {{isRecording ? '⏹ 停止录音' : '🎤 开始跟读'}}
          </button>
        </view>
        <view class="asr-tip" wx:if="{{!asrReady}}">
          <text>未配置语音识别插件，当前按音量检测评分</text>
        </view>
      </view>

      <!-- 跟读剧本模式 -->
      <view class="training-content" wx:if="{{currentMode === 'chat'}}">

        <!-- 情景选择 -->
        <block wx:if="{{!currentScene}}">
          <view class="scene-hint">选择一个情景开始跟读练习</view>
          <view class="scene-grid">
            <view class="scene-card" wx:for="{{scriptScenes}}" wx:key="name" bindtap="chooseScene" data-idx="{{index}}">
              <text class="scene-icon">{{item.icon}}</text>
              <text class="scene-name">{{item.name}}</text>
              <text class="scene-count">{{item.sentences.length}} 句</text>
            </view>
          </view>
        </block>

        <!-- 跟读中 -->
        <block wx:if="{{currentScene && !scriptDone}}">
          <view class="scene-head">
            <button class="back-btn" bindtap="backToScenes">‹ 情景</button>
            <text class="scene-title">{{currentScene.name}}</text>
            <text class="script-count">{{scriptIndex + 1}} / {{scriptSentences.length}}</text>
          </view>
          <view class="script-bar">
            <view class="script-fill" style="width: {{(scriptIndex / scriptSentences.length) * 100}}%;"></view>
          </view>

          <view class="script-word">
            <text class="script-word-text">{{scriptSentences[scriptIndex].text}}</text>
          </view>
          <view class="heard-text" wx:if="{{recordingText}}">
            <text>{{recordingText}}</text>
          </view>
          <view class="recording-box" wx:if="{{isRecording}}">
            <view class="recording-pulse"></view>
            <text class="recording-text">录音中，跟读「{{scriptSentences[scriptIndex].text}}」，说完再点一次停止</text>
          </view>
          <view class="btn-row">
            <button class="btn btn-secondary" bindtap="playScriptSound">🔊 听示范</button>
            <button class="btn {{isRecording ? 'btn-danger' : 'btn-primary'}}" bindtap="startRecord">
              {{isRecording ? '⏹ 停止录音' : '🎤 开始跟读'}}
            </button>
          </view>
          <button class="btn btn-secondary" bindtap="nextScript" disabled="{{isRecording}}" style="margin-top:16rpx">
            {{scriptIndex === scriptSentences.length - 1 ? '完成剧本' : '下一句 →'}}
          </button>
        </block>

        <!-- 完成汇总 -->
        <view class="script-summary" wx:if="{{scriptDone}}">
          <text class="summary-title">🎉 剧本完成！</text>
          <text class="summary-scene">{{currentScene.name}} · 平均 {{scriptAvg}} 分</text>
          <view class="script-scores" wx:if="{{scriptScores.length}}">
            <view class="score-chip" wx:for="{{scriptSentences}}" wx:key="index">
              <text class="chip-text">{{item.text}}</text>
              <text class="chip-score">{{scriptScores[index] || 0}}</text>
            </view>
          </view>
          <view class="btn-row">
            <button class="btn btn-primary" bindtap="restartScript">再练一遍</button>
            <button class="btn btn-secondary" bindtap="backToScenes">换情景</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 练习建议 -->
    <view class="card" wx:if="{{aiSuggestion}}">
      <view class="card-header">
        <text class="card-title">💡 练习建议</text>
      </view>
      <text class="suggestion-text">{{aiSuggestion}}</text>
    </view>

    <!-- 训练统计 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">本次训练</text>
      </view>
      <view class="stat-grid">
        <view class="stat-item">
          <text class="stat-value">{{trainingCount}}</text>
          <text class="stat-label">训练次数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{avgScore}}%</text>
          <text class="stat-label">平均得分</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{duration}}min</text>
          <text class="stat-label">训练时长</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
