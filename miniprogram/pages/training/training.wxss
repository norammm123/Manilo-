/* pages/training/training.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.nav-bar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 140rpx 40rpx 60rpx;
  border-radius: 0 0 60rpx 60rpx;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.nav-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 12rpx;
  display: block;
}

.mode-list {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.mode-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.mode-card.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.mode-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.mode-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.training-card {
  margin: 24rpx 32rpx;
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.training-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.training-content {
  text-align: center;
  padding: 40rpx 0;
}

.echo-display {
  margin-bottom: 40rpx;
}

.echo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.echo-word {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-main);
}

.echo-pinyin {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.speak-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: conic-gradient(var(--primary) 0deg, var(--border) 0deg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 40rpx;
}

.ring-inner {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-score {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

.ring-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.speak-word {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 40rpx;
}

.chat-area {
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 40rpx;
  min-height: 300rpx;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.chat-avatar.me {
  background: var(--success);
}

.chat-bubble {
  flex: 1;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--text-main);
}

.suggestion-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.8;
}
